components/About/About.js",[],[],[],"/Users/mac/Desktop/new/src/components/Admin/AdminDashboard.js",[],[],"/Users/mac/Desktop/new/src/components/NavBar/Navbar.js",["131"],[],"/Users/mac/Desktop/new/src/components/Home/Home.js",[],[],[],"/Users/mac/Desktop/new/src/firebaseConfig.js",[],[],"/Users/mac/Desktop/new/src/components/Contact/Contact.js",[],[],"/Users/mac/Desktop/new/src/components/Student/ExamPage.js",[],[],"/Users/mac/Desktop/new/src/components/Student/ViewScore.js",[],[],"/Users/mac/Desktop/new/src/components/Teacher/TeacherLogin.js",[],[],"/Users/mac/Desktop/new/src/components/Teacher/CreateExam.js",[],[],"/Users/mac/Desktop/new/src/components/Teacher/ViewStudentScores.js",[],[],"/Users/mac/Desktop/new/src/components/Student/StudentLogin.js",[],[],"/Users/mac/Desktop/new/src/components/Admin/AdminLogin.js",[],[],"/Users/mac/Desktop/new/src/components/Admin/ManageStudents.js",["132","133","134","135"],[],"/Users/mac/Desktop/new/src/components/Admin/ManageTeachers.js",["136","137","138","139"],[],"/Users/mac/Desktop/new/src/components/Admin/ViewStudentList.js",["140"],[],"/Users/mac/Desktop/new/src/components/Admin/ViewTeachersList.js",["141"],[],"/Users/mac/Desktop/new/src/components/Admin/ViewExamsScore.js",["142"],[],"import React, { useState, useEffect } from \"react\";\nimport { collection, getDocs } from \"firebase/firestore\";\nimport { db } from \"../../firebaseConfig\";\nimport \"./ManageStudents.css\";\n\nconst AdminViewExamScores = () => {\n  const [students, setStudents] = useState([]);\n\n  const StudentsCollectionRef = collection(db, \"students\");\n\n  // Fetch students and their exam scores from Firestore\n  const fetchStudents = async () => {\n    const data = await getDocs(StudentsCollectionRef);\n    const studentsData = data.docs.map((doc) => ({ ...doc.data(), id: doc.id }));\n\n    // Sort students alphabetically by name\n    studentsData.sort((a, b) => a.name.localeCompare(b.name));\n\n    setStudents(studentsData);\n  };\n\n  useEffect(() => {\n    fetchStudents();\n  }, []);\n\n  return (\n    <div className=\"manage-students-container\">\n      <h2>View Students' Exam Scores</h2>\n      <table className=\"students-table\">\n        <thead>\n          <tr>\n            <th>Name</th>\n            <th>Email</th>\n            <th>Class</th>\n            <th>Exam Scores</th>\n          </tr>\n        </thead>\n        <tbody>\n          {students.length === 0 ? (\n            <tr>\n              <td colSpan=\"4\">No students registered yet.</td>\n            </tr>\n          ) : (\n            students.map((student) => (\n              <tr key={student.id}>\n                <td>{student.name}</td>\n                <td>{student.email}</td>\n                <td>{student.studentClass}</td>\n                <td>\n                  {/* Displaying the exam score(s) */}\n                  {student.examScores ? (\n                    Array.isArray(student.examScores) ? (\n                      student.examScores.map((score, index) => (\n                        <div key={index}>Exam {index + 1}: {score}</div>\n                      ))\n                    ) : (\n                      <div>{student.examScores}</div>\n                    )\n                  ) : (\n                    <div>No scores available</div>\n                  )}\n                </td>\n              </tr>\n            ))\n          )}\n        </tbody>\n      </table>\n    </div>\n  );\n};\n\nexport default AdminViewExamScores;\n","/Users/mac/Desktop/new/src/components/Footer/Footer.js",[],[],"/Users/mac/Desktop/new/src/components/Student/Exam/Exam.js",[],[],{"ruleId":"143","severity":1,"message":"144","line":44,"column":6,"nodeType":"145","endLine":44,"endColumn":8,"suggestions":"146"},{"ruleId":"147","severity":1,"message":"148","line":15,"column":10,"nodeType":"149","messageId":"150","endLine":15,"endColumn":18},{"ruleId":"143","severity":1,"message":"151","line":36,"column":6,"nodeType":"145","endLine":36,"endColumn":8,"suggestio